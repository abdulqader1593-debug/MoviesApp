<layout>
    <data>
        <variable
            name="viewmodel"
            type="com.example.moviesapp.viewmodels.MoviesViewModel" />

        <variable
            name="movies"
            type="com.example.moviesapp.data.model.Movies" />
    </data>
    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#11111D"
        tools:context=".ui.activities.MoviesList">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="16dp">

                <!-- Profile Image -->
                <ImageView
                    android:id="@+id/img_profile"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="Profile Image"
                    android:src="@drawable/outline_person_24" />

                <!-- User Name -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- 1. Top Greeting / Subtitle -->
                    <!--
                    <TextView
                        android:id="@+id/tv_greeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{viewModel.moviesState.greeting}"
                        android:textColor="#8E8E93"
                        android:textSize="12sp" />
                    -->
                    <TextView
                        android:id="@+id/tv_greeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hello"
                        android:textColor="#8E8E93"
                        android:textSize="12sp" />

                    <!-- 2. User Name -->
                    <!--
                    <TextView
                        android:id="@+id/tv_user_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        app:textValue="@{viewModel.moviesState.username}"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    -->
                    <TextView
                        android:id="@+id/tv_user_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:text="@{viewmodel.userName}"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Notification Icon -->
                <ImageView
                    android:id="@+id/btn_notification"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:contentDescription="Notifications"
                    android:src="@drawable/outline_notifications_unread_24" />

                <!-- Menu Icon -->
                <ImageView
                    android:id="@+id/btn_menu"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Menu"
                    android:src="@drawable/outline_menu_24" />
            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>

        <!-- 2. Pure XML Movies List (RecyclerView) -->
        <!--    <androidx.recyclerview.widget.RecyclerView-->
        <!--        android:id="@+id/rv_movies"-->
        <!--        android:layout_width="0dp"-->
        <!--        android:layout_height="0dp"-->
        <!--        android:clipToPadding="false"-->
        <!--        android:padding="16dp"-->
        <!--        app:layout_constraintBottom_toBottomOf="parent"-->
        <!--        app:layout_constraintEnd_toEndOf="parent"-->
        <!--        app:layout_constraintStart_toStartOf="parent"-->
        <!--        app:layout_constraintTop_toBottomOf="@id/toolbar" />-->

        <androidx.viewpager2.widget.ViewPager2
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/movieViewPager"
            app:layout_constraintTop_toBottomOf="@id/toolbar"
            />

    <TextView
        android:id="@+id/tv_categories_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/movieViewPager"
        app:layout_constraintStart_toStartOf="parent"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:text="Categories"
        />

    <TextView
        android:id="@+id/tv_see_all_categories"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:layout_constraintBaseline_toBaselineOf="@id/tv_categories_title"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="See All"
        android:textColor="#8E8E93"
        android:textSize="14sp"
        />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_categories"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        app:categories="@{viewmodel.moviesState.chips}"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_category_chip"
        app:layout_constraintTop_toBottomOf="@id/tv_categories_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp" />

    <TextView
        android:id="@+id/tv_latest_movies_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/rv_categories"
        app:layout_constraintStart_toStartOf="parent"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:text="Latest Movies"
        />

    <TextView
        android:id="@+id/tv_see_all_latest_movies"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:layout_constraintBaseline_toBaselineOf="@id/tv_latest_movies_title"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="See All"
        android:textColor="#8E8E93"
        android:textSize="14sp"
        />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_latest_movies"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_category_chip"
        app:latestMovies="@{viewmodel.moviesState.latestMovies}"
        app:layout_constraintTop_toBottomOf="@id/tv_latest_movies_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp" />


    <TextView
        android:id="@+id/tv_trending_movies_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/rv_latest_movies"
        app:layout_constraintStart_toStartOf="parent"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:text="Trending Movies"
        />

    <TextView
        android:id="@+id/tv_see_all_trending_movies"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:layout_constraintBaseline_toBaselineOf="@id/tv_trending_movies_title"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="See All"
        android:textColor="#8E8E93"
        android:textSize="14sp"
        />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_trending_movies"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_category_chip"
        app:layout_constraintTop_toBottomOf="@id/tv_trending_movies_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
<!--</layout>-->
</layout>